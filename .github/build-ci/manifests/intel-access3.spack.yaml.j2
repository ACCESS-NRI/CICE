spack:
  specs:
  - access-cice @git.{{ ref }} +access3 io_type=PIO
  packages:
    python:
      require:
      - '@3.11.14'
    intel-oneapi-compilers-classic:
      require:
      - '@{{ intel_compiler_version }}'
    all:
      require:
      - '%access_intel'
      - target={{ target }}
  concretizer:
    unify: false
  view: false
