spack:
  specs:
  - access-cice @git.{{ ref }} ~access3 io_type=PIO %intel@2021.10.0 target=x86_64
  - access-cice @git.{{ ref }} ~access3 io_type=NetCDF %intel@2021.10.0 target=x86_64
  - access-cice @git.{{ ref }} ~access3 io_type=Binary %intel@2021.10.0 target=x86_64
  packages:
    all:
      require:
      - '%intel@2021.10.0 target=x86_64'
  concretizer:
    unify: false
  view: false
