spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config
  specs:
    - access-cice @git.{{ ref }} ~access3 io_type=PIO +openmp %%access_oneapi
    - access-cice @git.{{ ref }} ~access3 io_type=PIO %%access_oneapi
    - access-cice @git.{{ ref }} ~access3 io_type=NetCDF %%access_oneapi
    - access-cice @git.{{ ref }} ~access3 io_type=Binary %%access_oneapi
  view: false
